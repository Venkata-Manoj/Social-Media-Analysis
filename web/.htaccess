# .htaccess — SocialPulse DSA0606 — Apache fallback (SPA routing + cache + CORS)
# Place this file alongside index.html on Apache hosts (cPanel, shared hosting).
# All paths are relative-safe; works whether DocumentRoot is repo root or web/.
# If Apache Ignores .htaccess, ensure AllowOverride All in vhost.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # CORS preflight
  RewriteCond %{REQUEST_METHOD} OPTIONS
  RewriteRule ^(.*)$ $1 [R=200,L]
  Header always set Access-Control-Allow-Origin "*" env=IS_CORS
  Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS" env=IS_CORS
  Header always set Access-Control-Allow-Headers "Content-Type, Authorization" env=IS_CORS

  # Do not rewrite real files/directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Exclude data/assets/api/web from SPA fallback — but allow them to be served normally
  RewriteCond %{REQUEST_URI} ^/data/ [OR]
  RewriteCond %{REQUEST_URI} ^/assets/ [OR]
  RewriteCond %{REQUEST_URI} ^/web/ [OR]
  RewriteCond %{REQUEST_URI} ^/api/
  RewriteRule ^ - [L]

  # SPA fallback: all other routes -> index.html (keeps canonical single-file)
  RewriteRule ^ index.html [L]
</IfModule>

# ---- Security headers ----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # CORS for data & assets
  <FilesMatch "\.(json|csv|png|jpg|jpeg|svg|woff2?)$">
    Header always set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# ---- Compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# ---- Caching ----
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML — never cache aggressively (dashboard updates with filters client-side, but ensure fresh deploy)
  ExpiresByType text/html "access plus 0 seconds"
  # Data — short cache (5 min) + must-revalidate
  ExpiresByType application/json "access plus 300 seconds"
  ExpiresByType text/csv "access plus 300 seconds"
  # Assets — 1 year immutable
  ExpiresByType image/png "access plus 31536000 seconds"
  ExpiresByType image/jpeg "access plus 31536000 seconds"
  ExpiresByType image/svg+xml "access plus 31536000 seconds"
  ExpiresByType font/woff2 "access plus 31536000 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Override cache for hashed/long-lived assets
  <FilesMatch "\.(png|jpg|jpeg|svg|woff2|webp)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(json|csv)$">
    Header always set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header always set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ---- MIME ----
AddType application/json .json
AddType text/csv .csv
AddType image/svg+xml .svg

# ---- Prevent directory listing ----
Options -Indexes

# ---- Custom 404 fallback (optional) ----
# ErrorDocument 404 /index.html
